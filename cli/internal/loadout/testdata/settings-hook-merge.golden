{
  "userPref": "dark-mode",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "echo golden-test"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*.go",
        "hooks": [
          {
            "type": "command",
            "command": "go vet"
          }
        ]
      }
    ]
  }
}