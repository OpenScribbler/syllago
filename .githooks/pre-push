#!/bin/sh
#
# Pre-push hook: fast lint of changed code only.
#
# Full lint, build, and generated-artifact freshness checks
# (commands.json, providers.json, telemetry.json) run in CI
# (.github/workflows/ci.yml) — they are intentionally NOT
# duplicated here to keep pushes fast.
#

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ] || [ ! -d "$REPO_ROOT/cli" ]; then
    exit 0
fi

if ! command -v golangci-lint >/dev/null 2>&1; then
    exit 0
fi

MERGE_BASE=$(git merge-base HEAD origin/main 2>/dev/null)
if [ -z "$MERGE_BASE" ]; then
    exit 0
fi

echo "Linting changed code (full lint runs in CI)..."
if ! (cd "$REPO_ROOT/cli" && golangci-lint run --new-from-rev="$MERGE_BASE" ./...); then
    echo "" >&2
    echo "Error: golangci-lint found issues in changed code." >&2
    echo "Run: cd cli && golangci-lint run --new-from-rev=origin/main ./..." >&2
    exit 1
fi

exit 0
